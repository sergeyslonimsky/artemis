# macOS
.DS_Store

# Xcode build output and per-user state
build/
DerivedData/
*.xcresult
xcuserdata/
*.xcuserstate
*.moved-aside
*.xccheckout
*.xcscmblueprint
# The workspace inside the project is generated; only its shared package pins are kept.
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Archives and symbols
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/

# Your signing settings (see Config/Local.xcconfig.example)
Config/Local.xcconfig

# Editors and tools
.idea/
.vscode/
.claude/settings.local.json
*.swp

# Local working notes
PLAN.md

# Secrets, should any ever appear
.env
.env.*
*.p12
*.mobileprovision
*.cer
